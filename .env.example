# .env.example - Example environment variables for running generated test suites
# Copy to .env (do NOT commit .env to GitHub)

# Target Web API Base URL
BASE_URL=https://dummyjson.com

# Kimi / Moonshot API Key (from https://platform.moonshot.ai)
KIMI_API_KEY=your_kimi_api_key_here

# Optional: Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Auth Token for backend testing
AUTH_TOKEN=your_auth_token_here

